PORT=5000
MONGODB_URI=mongodb://localhost:27017/healthbridge
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
NODE_ENV=development

# ─── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
# Required for email notifications to work.
# For Gmail: enable 2-Step Verification, then generate an App Password at:
#   https://myaccount.google.com/apppasswords
# Set EMAIL_USER to your Gmail address, EMAIL_PASSWORD to the App Password.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=HealthBridge <noreply@healthbridge.com>

# Cloudinary (optional – for medical document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Admin SDK (FCM push notifications) ──────────────────────────────
# Option A: Full service account JSON as single line (recommended)
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Individual fields
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
